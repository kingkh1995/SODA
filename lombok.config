# 本文件承载禁用清单的编译期拦截（单源 docs/conventions/lombok.md §1.2）：Lombok 官方 flagUsage 机制把「评审纪律」升为编译不变量。
# 禁止 Lombok 在本目录树下继续向上查找父目录的配置（本文件即唯一配置源）。
config.stopBubbling = true

# —— 禁用项（命中即编译失败）——
lombok.data.flagUsage = error
lombok.value.flagUsage = error
lombok.toString.flagUsage = error
lombok.allArgsConstructor.flagUsage = error
lombok.superBuilder.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.cleanup.flagUsage = error
lombok.utilityClass.flagUsage = error
lombok.val.flagUsage = error
lombok.var.flagUsage = error

# 维护须知：
# 1. 禁写 lombok.experimental.flagUsage —— 该 blanket 键会一并阻断 @Accessors（本仓 15 处在用、属允许项），一写即构建红。
# 2. @SuperBuilder 的键无包前缀（lombok.superBuilder.flagUsage）；lombok.experimental.superBuilder.flagUsage 是未知键，静默失效。
# 3. 未知键不会让构建失败，本机制的唯一防呆手段是自检：修改本文件后执行
#        java -jar <lombok.jar> config <仓库根>
#    rc=2 表示存在未知键或坏值，rc=1 表示命令行或路径错误（rc=0 为通过）。
